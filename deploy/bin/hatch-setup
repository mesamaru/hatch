#!/usr/bin/env bash
# 初期設定画面の開き方（パネルの URL と初期設定コード）を表示します。設定そのものはパネルの画面で行います。
#   hatch-setup          URL とコードを表示
#   hatch-setup --code   コードだけを表示（スクリプト用）
#   hatch-setup --reset  初期設定をやり直す（管理者がログインできなくなったときなど）
set -Eeuo pipefail
DATA=/var/lib/hatch
CODE_FILE="$DATA/setup-code"
ENV_FILE=/etc/hatch/hatch.env
[[ $EUID -eq 0 ]] || { echo "root で実行してください"; exit 1; }

sql() { runuser -u postgres -- psql -d hatch -tAqc "$1" 2>/dev/null || true; }
done_at() { sql "SELECT value #>> '{}' FROM app_settings WHERE key = 'setup_completed_at'"; }
envget() { # setup.env（画面で保存した値）を優先して読む
  local v=""
  if [[ -f "$DATA/setup.env" ]]; then v="$(sed -n "s/^$1=//p" "$DATA/setup.env" | tail -1)"; fi
  if [[ -z "$v" && -f "$ENV_FILE" ]]; then v="$(sed -n "s/^$1=//p" "$ENV_FILE" | tail -1)"; fi
  printf '%s' "$v"
}
ensure_code() {
  if [[ ! -s "$CODE_FILE" ]]; then
    python3 -c 'import secrets
a = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"
c = "".join(secrets.choice(a) for _ in range(12))
print(f"{c[:4]}-{c[4:8]}-{c[8:]}")' > "$CODE_FILE.tmp"
    chown hatch:hatch "$CODE_FILE.tmp"
    chmod 600 "$CODE_FILE.tmp"
    mv "$CODE_FILE.tmp" "$CODE_FILE"
  fi
  cat "$CODE_FILE"
}

case "${1:-}" in
  --code) ensure_code; exit 0 ;;
  --reset)
    sql "UPDATE app_settings SET value = 'null' WHERE key = 'setup_completed_at'" >/dev/null
    rm -f "$CODE_FILE"
    echo " 初期設定をやり直せる状態にしました。今の設定値は残っているので、変える項目だけ入力してください。"
    ;;
  "") ;;
  *) sed -n '2,5p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac

LOCAL_URL="http://$(hostname -I | awk '{print $1}'):$(envget PD_PORT | grep . || echo 8080)"
PUBLIC_URL="$(envget PD_PUBLIC_URL)"
DONE="$(done_at)"

echo
if [[ -n "$DONE" ]]; then
  echo " 初期設定は完了しています（${DONE%%.*}）。"
  echo "   パネル: ${PUBLIC_URL:-$LOCAL_URL}"
  echo "   設定をやり直す場合: hatch-setup --reset"
  echo
  exit 0
fi

CODE="$(ensure_code)"
cat << MSG
 Hatch の初期設定

   1. ブラウザでパネルを開いてください
        ${LOCAL_URL}
MSG
if [[ -n "$PUBLIC_URL" && "$PUBLIC_URL" != "$LOCAL_URL" ]]; then
  echo "        （公開済みなら ${PUBLIC_URL} でも開けます）"
fi
cat << MSG

   2. 画面の案内に沿って、次の初期設定コードを入力してください
        ${CODE}

   あとは画面で、ゲームパネル・Cloudflare・Uptime Kuma・Discord の順に設定します。
   各キーの取り方は画面に表示されます。

MSG
