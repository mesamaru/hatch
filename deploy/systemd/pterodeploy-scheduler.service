[Unit]
Description=pterodeploy 定期処理
After=network-online.target postgresql.service
Wants=network-online.target
PartOf=pterodeploy.target

[Service]
Type=simple
User=pterodeploy
Group=pterodeploy
EnvironmentFile=/etc/pterodeploy/pterodeploy.env
Environment=PD_GAMES_FILE=/etc/pterodeploy/games.yml
WorkingDirectory=/opt/pterodeploy/current
ExecStart=/opt/pterodeploy/current/.venv/bin/python -m pterodeploy.scheduler
TimeoutStopSec=30
KillSignal=SIGTERM
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pterodeploy/shared /var/lib/pterodeploy

[Install]
WantedBy=pterodeploy.target
