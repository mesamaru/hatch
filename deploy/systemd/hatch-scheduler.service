[Unit]
Description=Hatch 定期処理
After=network-online.target postgresql.service
Wants=network-online.target
PartOf=hatch.target

[Service]
Type=simple
User=hatch
Group=hatch
EnvironmentFile=/etc/hatch/hatch.env
Environment=PD_GAMES_FILE=/etc/hatch/games.yml
WorkingDirectory=/opt/hatch/current
ExecStart=/opt/hatch/current/.venv/bin/python -m hatch.scheduler
TimeoutStopSec=30
KillSignal=SIGTERM
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hatch/shared /var/lib/hatch

[Install]
WantedBy=hatch.target
